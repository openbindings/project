{
  "format": "openbindings.repository-catalog@1",
  "repositories": {
    "jsonata": {
      "repository": "openbindings/jsonata",
      "role": "artifact-runtime",
      "cohortTier": "required",
      "defaultBranch": "main",
      "integrationRef": "main",
      "releaseMechanism": "annotated-module-tags-and-npm"
    },
    "spec": {
      "repository": "openbindings/spec",
      "role": "normative-specification",
      "cohortTier": "required",
      "defaultBranch": "main",
      "integrationRef": "release/0.2",
      "releaseMechanism": "annotated-semver-tag"
    },
    "interfaces": {
      "repository": "openbindings/interfaces",
      "role": "shared-contracts",
      "cohortTier": "required",
      "defaultBranch": "main",
      "integrationRef": "main",
      "releaseMechanism": "immutable-version-files"
    },
    "go": {
      "repository": "openbindings/openbindings-go",
      "role": "legacy-implementation",
      "cohortTier": "required",
      "defaultBranch": "main",
      "integrationRef": "release/0.2",
      "releaseMechanism": "annotated-module-tags"
    },
    "typescript": {
      "repository": "openbindings/openbindings-ts",
      "role": "legacy-implementation",
      "cohortTier": "required",
      "defaultBranch": "main",
      "integrationRef": "release/0.2",
      "releaseMechanism": "annotated-semver-tag-and-npm-oidc"
    },
    "ob": {
      "repository": "openbindings/ob",
      "role": "cli-runtime",
      "cohortTier": "required",
      "defaultBranch": "release/0.2",
      "integrationRef": "release/0.2",
      "releaseMechanism": "cargo-unpublished-rust-cli-preview"
    },
    "elements": {
      "repository": "openbindings/elements",
      "role": "ui-packages",
      "cohortTier": "extended",
      "defaultBranch": "main",
      "integrationRef": "main",
      "releaseMechanism": "npm"
    },
    "web": {
      "repository": "openbindings/web",
      "role": "publication",
      "cohortTier": "extended",
      "defaultBranch": "main",
      "integrationRef": "main",
      "releaseMechanism": "manual-deployment"
    },
    "openapi-client": {
      "repository": "openbindings/openapi-client",
      "role": "artifact-runtime",
      "cohortTier": "required",
      "defaultBranch": "main",
      "integrationRef": "main",
      "releaseMechanism": "cargo-unpublished-with-legacy-go-and-npm"
    },
    "asyncapi-client": {
      "repository": "openbindings/asyncapi-client",
      "role": "artifact-runtime",
      "cohortTier": "required",
      "defaultBranch": "main",
      "integrationRef": "main",
      "releaseMechanism": "annotated-module-tags-and-npm"
    },
    "sdk": {
      "repository": "openbindings/sdk",
      "role": "reference-implementation",
      "cohortTier": "extended",
      "defaultBranch": "main",
      "integrationRef": "main",
      "releaseMechanism": "cargo-and-npm-unpublished"
    }
  }
}
